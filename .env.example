# Public URL of the separately deployed community recording API.
# Leave blank to keep recording private and device-only.
VITE_COMMUNITY_API_URL=http://127.0.0.1:8787
# The same server also provides the cached JPL Horizons distance endpoint.
VITE_MISSION_API_URL=http://127.0.0.1:8787

# Server-only values. Never expose COMMUNITY_ADMIN_TOKEN through a VITE_ variable.
COMMUNITY_ALLOWED_ORIGIN=http://127.0.0.1:5173
COMMUNITY_ADMIN_TOKEN=replace-with-a-long-random-secret
COMMUNITY_DATA_DIR=./community-data
PORT=8787

# Optional, server-side only. Configure in Netlify Environment variables, not Vite.
# CLASSROOM_OPENAI_API_KEY=your-own-api-key
